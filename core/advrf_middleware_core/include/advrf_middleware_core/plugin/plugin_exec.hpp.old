#pragma once

#include <atomic>
#include <chrono>
#include <csignal>
#include <memory>
#include <thread>
#include <vector>

#include "advrf_middleware_core/adapters/adapter_base.hpp"
#include "advrf_middleware_core/utils/log.hpp"

namespace advrf::plugin {

struct Process
{
    std::string name;
    std::weak_ptr<AdapterBase> adapter;
    std::chrono::microseconds period_microseconds{10};
};

class PluginExec
{
public:
    PluginExec()
    {
        std::signal(SIGINT, SignalHandler);
        std::signal(SIGTERM, SignalHandler);
    }

    virtual ~PluginExec()
    {
        stop();
    }

    void register_adapter(Process process)
    {
        processes_.push_back(std::move(process));
    }

    void start(bool wait_for_exit = true)
    {
        LOG_INFO("Application Started (Ctrl+C to exit).");
        running_ = true;
        for (const auto& process : processes_)
        {
            auto adapter = process.adapter.lock();
            if (!adapter)
            {
                LOG_ERROR("Adapter '{}' is expired.", process.name);
                continue;
            }

            if (!adapter->start())
            {
                LOG_ERROR("Adapter '{}' failed to start.", process.name);
                running_ = false;
                break;
            }

            threads_.emplace_back(
                [adapter,
                 name = process.name,
                 period = process.period_microseconds]()
                {
                    LOG_INFO("Adapter '{}' started, frequency: {} Hz", name, 1'000'000 / period.count());
                    auto next = std::chrono::steady_clock::now();
                    auto next_health_check = next;
                    while (running_)
                    {
                        next += period;
                        if (std::chrono::steady_clock::now() >= next_health_check)
                        {
                            if (!adapter->is_ok())
                            {
                                LOG_ERROR("Adapter '{}' stopped unexpectedly.", name);
                                running_ = false;
                                break;
                            }
                            next_health_check += std::chrono::seconds(1);
                        }
                        adapter->spin_once();
                        std::this_thread::sleep_until(next);
                    }
                });
        }

        if (wait_for_exit)
        {
            while (running_)
                std::this_thread::sleep_for(std::chrono::milliseconds(100));
            stop();
            LOG_INFO("Application exited.");
        }
    }

    void stop()
    {
        if (!running_.exchange(false) && threads_.empty())
            return;

        for (auto& thread : threads_)
        {
            if (thread.joinable())
                thread.join();
        }

        threads_.clear();
    }

private:
    static void SignalHandler(int) noexcept
    {
        running_ = false;
    }

    static inline std::atomic_bool running_{false};

    std::vector<Process> processes_;
    std::vector<std::thread> threads_;
};

}