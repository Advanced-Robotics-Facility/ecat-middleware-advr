@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(advrf_interfaces_dds_BUILD_FASTDDS @BUILD_FASTDDS@)
set(advrf_interfaces_dds_BUILD_CYCLONEDDS @BUILD_CYCLONEDDS@)

if(advrf_interfaces_dds_BUILD_FASTDDS)
    find_dependency(fastcdr 2)
    find_dependency(fastdds 3)
endif()

if(advrf_interfaces_dds_BUILD_CYCLONEDDS)
    find_dependency(CycloneDDS)
    find_dependency(CycloneDDS-CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/advrf_interfaces_ddsTargets.cmake")
check_required_components(advrf_interfaces_dds)