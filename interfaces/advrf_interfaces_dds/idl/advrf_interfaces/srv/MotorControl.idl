#pragma once
#include "../../rcl_interfaces/msg/RequestHeader.idl"

module advrf_interfaces {
  module srv {
    module dds_ {
      // Service framing is handled here in the middleware, never by ROS clients.
      @final
      struct MotorControl_Request_ {
        rcl_interfaces::msg::dds_::RequestHeader_ request_id;
        int32 motor_id;
        uint8 command;
        uint32 control_mode;
        float gains[5];
      };
      @final
      struct MotorControl_Response_ {
        rcl_interfaces::msg::dds_::RequestHeader_ request_id;
        boolean success;
        boolean outcome_unknown;
        string message;
      };
    };
  };
};
