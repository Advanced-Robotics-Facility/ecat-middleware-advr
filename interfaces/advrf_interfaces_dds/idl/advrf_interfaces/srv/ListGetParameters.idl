#pragma once

#include "../../rcl_interfaces/msg/RequestHeader.idl"
#include "../../rcl_interfaces/msg/Parameter.idl"

module advrf_interfaces {
  module srv {
    module dds_ {

      /** @brief Request all parameters whose names match a prefix. */
      @final
      struct ListGetParameters_Request_
      {
        /// DDS request/reply correlation header.
        rcl_interfaces::msg::dds_::RequestHeader_ request_id;
        /// Prefix used to select parameter names.
        string prefix;
      };

      /** @brief Result of a prefixed parameter lookup. */
      @final
      struct ListGetParameters_Response_
      {
        /// DDS request/reply correlation header.
        rcl_interfaces::msg::dds_::RequestHeader_ request_id;
        /// Whether the request was processed successfully.
        boolean success;
        /// Matching parameter values.
        sequence<rcl_interfaces::msg::dds_::Parameter_> parameters;
      };

    };
  };
};
