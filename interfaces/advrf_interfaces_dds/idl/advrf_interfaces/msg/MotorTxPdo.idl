#pragma once

module advrf_interfaces {
  module msg {
        module dds_ {
            /** @brief Command PDO for one motor drive. */
            struct MotorTxPdo_
            {
                /// Target EtherCAT device identifier.
                int32 ecat_id;
                /// Position reference.
                float pos_ref;
                /// Velocity reference.
                float vel_ref;
                /// Torque reference.
                float tor_ref;
                /// Current reference.
                float cur_ref;
                /// Device-specific gain slot 0.
                float gain_0;
                /// Device-specific gain slot 1.
                float gain_1;
                /// Device-specific gain slot 2.
                float gain_2;
                /// Device-specific gain slot 3.
                float gain_3;
                /// Device-specific gain slot 4.
                float gain_4;
                /// Fault-acknowledgement command.
                unsigned long fault_ack;
                /// Command timestamp or sequence value.
                unsigned long ts;
                /// Auxiliary operation index.
                unsigned long op_idx_aux;
                /// Auxiliary operation value.
                float aux;
            };
            
            /** @brief Batch of motor command PDOs. */
            struct MotorTxPdoVector_
            {
                /// Commands, one for each addressed motor.
                sequence<MotorTxPdo_> data;
            };
        };
    };
};
